{
  "name": "second_dataset_experiment",
  "opensearch": {
    "host": "localhost",
    "port": 9200,
    "use_ssl": false,
    "verify_certs": false,
    "timeout": 30
  },
  "index": {
    "name": "ir_experiment_dataset2",
    "number_of_shards": 1,
