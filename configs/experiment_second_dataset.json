  "reuse_model": true,
  "reuse_model_id": "REPLACE_WITH_MODEL_ID_FROM_FIRST_EXPERIMENT",
  "reuse_pipeline": true,
  "reuse_pipeline_name": "embedding_pipeline_v1",
  "skip_index_creation": false,
  "skip_model_deployment": true,
  "skip_pipeline_creation": true
}
